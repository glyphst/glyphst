name "Modus Operandi Tinted"
appearance "light"
colors {
    background "#fbf7f0"
    page "#fbf7f0"
    selection-highlight "#f0c1cf3d"
    highlight-yellow "#fff57666"
    highlight-green "#b3fabf66"
    highlight-blue "#ccdfff66"
    highlight-pink "#ffddff66"
    highlight-orange "#ffcfbf66"
    overlay "#00000033"
    footer-background "#efe9dd"
    footer-border "#9f9690"
    footer-text "#595959"
    panel-background "#efe9dd"
    panel-border "#9f9690"
    surface-background "#efe9dd"
    border "#9f9690"
    border-variant "#dfd5cf"
    border-focused "#0000b0"
    tab-bar-background "#e0d4ce"
    tab-active-background "#fbf7f0"
    tab-inactive-background "#c8b8b2"
    element-hover "#dfd5cf"
    element-selected "#c9b9b0"
    text "#000000"
    text-muted "#595959"
    placeholder-text "#595959ff"
    accent "#0000b0"
    match-highlight "#6d5000"
    selected-row "#c9b9b0ff"
    control-background "#efe9dd"
    control-border "#dfd5cf"
    control-hover "#dfd5cf"
    success "#006300"
    error "#a60000"
}
page-gap 4
