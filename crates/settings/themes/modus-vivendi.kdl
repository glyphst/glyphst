name "Modus Vivendi"
appearance "dark"
colors {
    background "#000000"
    page "#ffffff"
    selection-highlight "#2fafff3d"
    highlight-yellow "#d0bc0066"
    highlight-green "#44bc4466"
    highlight-blue "#2fafff66"
    highlight-pink "#feacd066"
    highlight-orange "#db7b5f66"
    overlay "#00000066"
    footer-background "#1e1e1e"
    footer-border "#646464"
    footer-text "#989898"
    panel-background "#1e1e1e"
    panel-border "#646464"
    surface-background "#1e1e1e"
    border "#646464"
    border-variant "#303030"
    border-focused "#00bcff"
    tab-bar-background "#313131"
    tab-active-background "#000000"
    tab-inactive-background "#545454"
    element-hover "#303030"
    element-selected "#535353"
    text "#ffffff"
    text-muted "#989898"
    placeholder-text "#989898ff"
    accent "#00bcff"
    match-highlight "#d0bc00"
    selected-row "#535353ff"
    control-background "#1e1e1e"
    control-border "#303030"
    control-hover "#303030"
    success "#44bc44"
    error "#ff5f59"
}
page-gap 4
