name "Modus Operandi"
appearance "light"
colors {
    background "#ffffff"
    page "#ffffff"
    selection-highlight "#c0deff3d"
    highlight-yellow "#fff57666"
    highlight-green "#b3fabf66"
    highlight-blue "#ccdfff66"
    highlight-pink "#ffddff66"
    highlight-orange "#ffcfbf66"
    overlay "#00000033"
    footer-background "#f2f2f2"
    footer-border "#9f9f9f"
    footer-text "#595959"
    panel-background "#f2f2f2"
    panel-border "#9f9f9f"
    surface-background "#f2f2f2"
    border "#9f9f9f"
    border-variant "#e0e0e0"
    border-focused "#0000b0"
    tab-bar-background "#dfdfdf"
    tab-active-background "#ffffff"
    tab-inactive-background "#c2c2c2"
    element-hover "#e0e0e0"
    element-selected "#c4c4c4"
    text "#000000"
    text-muted "#595959"
    placeholder-text "#595959ff"
    accent "#0000b0"
    match-highlight "#6f5500"
    selected-row "#c4c4c4ff"
    control-background "#f2f2f2"
    control-border "#e0e0e0"
    control-hover "#e0e0e0"
    success "#006800"
    error "#a60000"
}
page-gap 4
