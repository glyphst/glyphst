name "One Light"
appearance "light"
colors {
    background "#dcdcdd"
    page "#ffffff"
    selection-highlight "#5c78e23d"
    highlight-yellow "#dec18466"
    highlight-green "#669f5966"
    highlight-blue "#5c78e266"
    highlight-pink "#a349ab66"
    highlight-orange "#ad6e2666"
    overlay "#00000033"
    footer-background "#ebebec"
    footer-border "#c9c9ca"
    footer-text "#58585a"
    panel-background "#ebebec"
    panel-border "#c9c9ca"
    surface-background "#ebebec"
    border "#c9c9ca"
    border-variant "#dfdfe0"
    border-focused "#7d82e8"
    tab-bar-background "#ebebec"
    tab-active-background "#fafafa"
    tab-inactive-background "#ebebec"
    element-hover "#dfdfe0"
    element-selected "#cacaca"
    text "#242529"
    text-muted "#58585a"
    placeholder-text "#7e8086ff"
    accent "#5c78e2"
    match-highlight "#d0a923"
    selected-row "#cacacaff"
    control-background "#ebebec"
    control-border "#dfdfe0"
    control-hover "#dfdfe0"
    success "#669f59"
    error "#d36151"
}
page-gap 4
