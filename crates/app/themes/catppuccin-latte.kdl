name "Catppuccin Latte"
appearance "light"
colors {
    background "#eff1f5"
    page "#ffffff"
    selection-highlight "#1e66f54d"
    highlight-yellow "#df8e1d4d"
    highlight-green "#40a02b4d"
    highlight-blue "#1e66f54d"
    highlight-pink "#ea76cb4d"
    highlight-orange "#fe640b4d"
    overlay "#00000033"
    footer-background "#e6e9ef"
    footer-border "#dce0e8"
    footer-text "#6c6f85"
    panel-background "#e6e9ef"
    panel-border "#dce0e8"
    text "#4c4f69"
    text-muted "#5c5f77"
    placeholder-text "#7c7f93aa"
    accent "#1e66f5"
    match-highlight "#fe640b"
    selected-row "#1e66f540"
    control-background "#eff1f5"
    control-border "#bcc0cc"
    control-hover "#ccd0da"
    success "#40a02b"
    error "#d20f39"
}
page-gap 4
