name "Glyphst Dark"
appearance "dark"
colors {
    background "#202020"
    page "#ffffff"
    selection-highlight "#61afef66"
    overlay "#00000066"
    footer-background "#181818"
    footer-border "#303030"
    footer-text "#aaaaaa"
    panel-background "#181818"
    panel-border "#343434"
    text "#d4d4d4"
    text-muted "#888888"
    placeholder-text "#888888aa"
    accent "#61afef"
    match-highlight "#e5c07b"
    selected-row "#3a3f4bcc"
    control-background "#242424"
    control-border "#3a3a3a"
    control-hover "#303030"
    success "#98c379"
    error "#e06c75"
}
page-gap 24
