name "One Dark"
appearance "dark"
colors {
    background "#282c34"
    page "#ffffff"
    selection-highlight "#61afef66"
    highlight-yellow "#e5c07b66"
    highlight-green "#98c37966"
    highlight-blue "#61afef66"
    highlight-pink "#c678dd66"
    highlight-orange "#d19a6666"
    overlay "#00000066"
    footer-background "#21252b"
    footer-border "#3b4048"
    footer-text "#abb2bf"
    panel-background "#21252b"
    panel-border "#3b4048"
    text "#abb2bf"
    text-muted "#828997"
    placeholder-text "#828997aa"
    accent "#61afef"
    match-highlight "#e5c07b"
    selected-row "#61afef26"
    control-background "#2c313a"
    control-border "#3b4048"
    control-hover "#353b45"
    success "#98c379"
    error "#e06c75"
}
page-gap 4
