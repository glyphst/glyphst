name "One Dark"
appearance "dark"
colors {
    background "#3b414d"
    page "#ffffff"
    selection-highlight "#74ade83d"
    highlight-yellow "#dec18466"
    highlight-green "#a1c18166"
    highlight-blue "#74ade866"
    highlight-pink "#b477cf66"
    highlight-orange "#bf956a66"
    overlay "#00000066"
    footer-background "#2f343e"
    footer-border "#464b57"
    footer-text "#a9afbc"
    panel-background "#2f343e"
    panel-border "#464b57"
    surface-background "#2f343e"
    border "#464b57"
    border-variant "#363c46"
    border-focused "#47679e"
    tab-bar-background "#2f343e"
    tab-active-background "#282c33"
    tab-inactive-background "#2f343e"
    element-hover "#363c46"
    element-selected "#454a56"
    text "#dce0e5"
    text-muted "#a9afbc"
    placeholder-text "#878a98ff"
    accent "#74ade8"
    match-highlight "#e8af74"
    selected-row "#454a56ff"
    control-background "#2f343e"
    control-border "#363c46"
    control-hover "#363c46"
