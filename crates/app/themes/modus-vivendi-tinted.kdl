name "Modus Vivendi Tinted"
appearance "dark"
colors {
    background "#0d0e1c"
    page "#ffffff"
    selection-highlight "#2fafff3d"
    highlight-yellow "#d0bc0066"
    highlight-green "#44bc4466"
    highlight-blue "#2fafff66"
    highlight-pink "#feacd066"
    highlight-orange "#db8b3f66"
    overlay "#00000066"
    footer-background "#1d2235"
    footer-border "#61647a"
    footer-text "#989898"
    panel-background "#1d2235"
    panel-border "#61647a"
    surface-background "#1d2235"
    border "#61647a"
    border-variant "#2b3045"
    border-focused "#00bcff"
    tab-bar-background "#2c3045"
    tab-active-background "#0d0e1c"
    tab-inactive-background "#4a4f6a"
    element-hover "#2b3045"
    element-selected "#4a4f69"
    text "#ffffff"
    text-muted "#989898"
    placeholder-text "#989898ff"
    accent "#00bcff"
    match-highlight "#d0bc00"
    selected-row "#4a4f69ff"
    control-background "#1d2235"
    control-border "#2b3045"
    control-hover "#2b3045"
    success "#44bc44"
    error "#ff5f59"
}
page-gap 4
