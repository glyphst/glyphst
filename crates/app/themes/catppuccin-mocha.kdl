name "Catppuccin Mocha"
appearance "dark"
colors {
    background "#1e1e2e"
    page "#ffffff"
    selection-highlight "#89b4fa66"
    overlay "#11111b99"
    footer-background "#181825"
    footer-border "#313244"
    footer-text "#a6adc8"
    panel-background "#181825"
    panel-border "#313244"
    text "#cdd6f4"
    text-muted "#9399b2"
    placeholder-text "#9399b2aa"
    accent "#89b4fa"
    match-highlight "#f9e2af"
    selected-row "#45475a99"
    control-background "#1e1e2e"
    control-border "#45475a"
    control-hover "#313244"
    success "#a6e3a1"
    error "#f38ba8"
}
page-gap 24
