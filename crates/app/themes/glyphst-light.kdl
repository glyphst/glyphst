name "Glyphst Light"
appearance "light"
colors {
    background "#e8e8e8"
    page "#ffffff"
    selection-highlight "#0969da4d"
    overlay "#00000033"
    footer-background "#f6f8fa"
    footer-border "#d0d7de"
    footer-text "#57606a"
    panel-background "#f8f8f8"
    panel-border "#d0d7de"
    text "#24292f"
    text-muted "#57606a"
    placeholder-text "#6e7781aa"
    accent "#0969da"
    match-highlight "#9a6700"
    selected-row "#0969da1f"
    control-background "#ffffff"
    control-border "#d0d7de"
    control-hover "#f3f4f6"
    success "#1a7f37"
    error "#cf222e"
}
page-gap 24
