[Desktop Entry]
Type=Application
Name=Glyphst Reader
GenericName=Document Reader
Comment=Read PDF and EPUB documents
TryExec=glyphst-reader
Exec=glyphst-reader %F
Icon=glyphst-reader
Categories=Office;Viewer;
MimeType=application/pdf;application/epub+zip;
Terminal=false
StartupNotify=true
StartupWMClass=glyphst-reader
