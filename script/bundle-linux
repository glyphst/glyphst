#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: script/bundle-linux

Build a portable Glyphst Reader archive for the current Linux architecture.

Run this script natively on Ubuntu 20.04 to produce binaries compatible with
glibc 2.31 and newer. Supported architectures are x86_64 and aarch64.

The glyphst-fonts checkout (GLYPHST_FONTS_DIR, default: ../fonts) is copied
into the bundle for the interface's CJK text and PDF translation.
EOF
}

fail() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

elf_interpreter() {
    readelf -lW "$1" |
        sed -n 's/.*Requesting program interpreter: \(.*\)]/\1/p'
}

case "${1:-}" in
    "")
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

workspace_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$workspace_dir"

fonts_dir="${GLYPHST_FONTS_DIR:-$workspace_dir/../fonts}"
[[ -f "$fonts_dir/fonts/manifest.txt" ]] ||
    fail "no glyphst-fonts checkout at $fonts_dir (set GLYPHST_FONTS_DIR)"

case "$(uname -m)" in
    x86_64)
        archive_arch="x86_64"
        target_triple="x86_64-unknown-linux-gnu"
        ;;
    aarch64|arm64)
        archive_arch="aarch64"
        target_triple="aarch64-unknown-linux-gnu"
        ;;
    *)
        fail "unsupported architecture: $(uname -m)"
        ;;
esac

for tool in cargo getconf gzip ldd readelf tar; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done

if command -v llvm-objcopy >/dev/null 2>&1; then
    objcopy="$(command -v llvm-objcopy)"
elif command -v objcopy >/dev/null 2>&1; then
    objcopy="$(command -v objcopy)"
else
    fail "required tool not found: llvm-objcopy or objcopy"
fi

host_interpreter="$(elf_interpreter "$(command -v bash)")"
if [[ "$host_interpreter" == /nix/store/* ]]; then
    fail "this host uses a Nix Store interpreter; run the script on Ubuntu 20.04 instead"
fi

glibc_version="$(getconf GNU_LIBC_VERSION)"
if [[ "$glibc_version" != "glibc 2.31" ]]; then
    fail "Ubuntu 20.04 with glibc 2.31 is required; found $glibc_version"
fi

target_root="${CARGO_TARGET_DIR:-$workspace_dir/target}"
if [[ "$target_root" != /* ]]; then
    target_root="$workspace_dir/$target_root"
fi

release_dir="$target_root/$target_triple/dist"
built_binary="$release_dir/glyphst-reader"
archive_dir="$target_root/release"
archive="$archive_dir/glyphst-reader-linux-$archive_arch.tar.gz"
rpath_link_args='-Wl,--disable-new-dtags,-rpath,$ORIGIN/../lib'

cargo rustc \
    --profile dist \
    --target "$target_triple" \
    --package glyphst-reader \
    --bin glyphst-reader \
    -- \
    -C "link-args=$rpath_link_args"

[[ -x "$built_binary" ]] || fail "built executable not found: $built_binary"

interpreter="$(elf_interpreter "$built_binary")"
if [[ "$interpreter" == /nix/store/* ]]; then
    fail "the executable uses a Nix Store interpreter; build on Ubuntu 20.04 instead"
fi

temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT

bundle_dir="$temp_dir/glyphst-reader.app"
binary_dir="$bundle_dir/bin"
library_dir="$bundle_dir/lib"
desktop_dir="$bundle_dir/share/applications"
share_dir="$bundle_dir/share/glyphst-reader"
packaged_binary="$binary_dir/glyphst-reader"

mkdir -p "$binary_dir" "$library_dir" "$desktop_dir" "$share_dir/fonts"
cp "$built_binary" "$packaged_binary"
"$objcopy" --strip-debug --remove-section=.debug_gdb_scripts "$packaged_binary"

if readelf -SW "$packaged_binary" | grep -Eq '\.(z?debug)_'; then
    fail "debug sections remain in the packaged executable"
fi
readelf -SW "$packaged_binary" | grep -q '\.eh_frame' ||
    fail "stack-unwinding information is missing from the packaged executable"
readelf -dW "$packaged_binary" | grep -Fq '$ORIGIN/../lib' ||
    fail "the packaged executable does not contain the bundle library rpath"

if ! ldd_output="$(ldd "$packaged_binary" 2>&1)"; then
    fail "failed to inspect runtime libraries: $ldd_output"
fi

declare -A copied_libraries=()
while IFS= read -r line; do
    read -r name marker path _ <<<"$line"

    if [[ "$marker" == "=>" ]]; then
        [[ "$path" != "not" ]] || fail "runtime library not found: $name"
        name="${name##*/}"
    elif [[ "$name" == /* ]]; then
        path="$name"
        name="${name##*/}"
    else
        continue
    fi

    case "$name" in
        linux-vdso.so.*|ld-linux*.so*|ld-musl*.so*|libc.so.*|libdl.so.*|libgcc_s.so.*|libm.so.*|libpthread.so.*|libresolv.so.*|librt.so.*)
            continue
            ;;
    esac

    [[ -f "$path" ]] || fail "runtime library is not a file: $path"
    if [[ -z "${copied_libraries[$name]:-}" ]]; then
        cp -L "$path" "$library_dir/$name"
        copied_libraries[$name]=1
    fi
done <<<"$ldd_output"

cp "$workspace_dir/crates/reader/glyphst-reader.desktop" "$desktop_dir/glyphst-reader.desktop"
cp "$workspace_dir/crates/reader/glyphst-reader-url.desktop" "$desktop_dir/glyphst-reader-url.desktop"
cp -R "$fonts_dir/fonts" "$fonts_dir/README.md" "$fonts_dir/ATTRIBUTION.md" "$share_dir/fonts/"
cp -R "$workspace_dir/crates/pdf-translation/assets" "$share_dir/pdf-translation"
cp "$workspace_dir/LICENSE" "$bundle_dir/LICENSE"

mkdir -p "$archive_dir"
rm -f "$archive"
tar -czf "$archive" -C "$temp_dir" glyphst-reader.app

printf 'Created %s\n' "$archive"
