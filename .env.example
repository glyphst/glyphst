# Explicit opt-in for the live PDF translation example. It can consume OCR and
# translation provider quota.
GLYPHST_LIVE_PDF_TRANSLATION=1

# Baidu Unlimited-OCR credentials. Copy this file to .env and fill both values;
# .env is ignored by Git.
GLYPHST_BAIDU_OCR_API_KEY=
GLYPHST_BAIDU_OCR_SECRET_KEY=

# Optional: use a settings file other than Glyphst Reader's normal config.kdl. The
# selected translation provider and its credentials still come from that file.
# GLYPHST_SETTINGS_PATH=/absolute/path/to/config.kdl
